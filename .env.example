# ── Discord ──────────────────────────────────────────
# dev=테스트 채널, prod=실제 채널
BOT_ENV=dev
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_DEV=
DISCORD_CHANNEL_PROD=
# 선택: 고정 thread에 댓글로 보낼 때 (비우면 채널에 새 thread 생성)
DISCORD_THREAD_DEV=
DISCORD_THREAD_PROD=

# ── 수집 ─────────────────────────────────────────────
# 선택: 알구몬을 열 Chrome 프로필 (chrome://version 프로필 경로의 마지막 부분)
CHROME_PROFILE=Default

# ── 모니터링 ─────────────────────────────────────────
# 선택: Healthchecks.io 핑 URL
# 매일 TOP 10 성공/실패 (실패 시 /fail)
HEALTHCHECK_BUY_OR_NOT_URL=
# 상주 봇이 5분마다 신호 → 맥 잠자기·꺼짐·봇 다운 감지 (check: period 20분, grace 10분)
HEALTHCHECK_SERVE_URL=

# ── LLM (v3 실험) ────────────────────────────────────
# Google AI Studio에서 발급한 Gemini API 키
GEMINI_API_KEY=
