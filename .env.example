# GitHub Actions에서는 이 내용을 비밀값 ENV_FILE에 그대로 넣는다 (BOT_ENV는 워크플로가 prod로 정함)

# ── Discord ──────────────────────────────────────────
# dev=테스트 채널, prod=실제 채널
BOT_ENV=dev
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_DEV=
DISCORD_CHANNEL_PROD=
# 핫딜 글·알림을 올리고 @멘션을 읽는 고정 thread
DISCORD_THREAD_DEV=
DISCORD_THREAD_PROD=

# ── LLM ──────────────────────────────────────────────
# Google AI Studio에서 발급한 Gemini API 키 (말 해석·설명형 알림 판단)
GEMINI_API_KEY=

# Actions에서는 별도 Repository Secret으로 주입 (값을 레포에 저장하지 않음)
MONITOR_ENDPOINT=
MONITOR_TOKEN=
HEALTHCHECK_URL=
