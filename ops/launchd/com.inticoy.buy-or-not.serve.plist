<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.inticoy.buy-or-not.serve</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/inticoy/GitHub/inticoy/buy-or-not/.venv/bin/python</string>
    <string>-m</string>
    <string>app</string>
    <string>serve</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/inticoy/GitHub/inticoy/buy-or-not</string>
