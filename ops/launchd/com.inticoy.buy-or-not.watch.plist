<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.inticoy.buy-or-not.watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/inticoy/GitHub/inticoy/buy-or-not/.venv/bin/python</string>
    <string>-m</string>
    <string>app</string>
    <string>watch</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/inticoy/GitHub/inticoy/buy-or-not</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>BOT_ENV</key>
    <string>prod</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>
  <!-- 매시 30분: hotdeal.zip 최신 딜을 훑어 관심사 알림 (12:00 TOP 10, 스냅샷과 겹치지 않게) -->
  <key>StartCalendarInterval</key>
  <dict><key>Minute</key><integer>30</integer></dict>
  <key>StandardOutPath</key>
  <string>/Users/inticoy/GitHub/inticoy/buy-or-not/logs/watch.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/inticoy/GitHub/inticoy/buy-or-not/logs/watch.log</string>
</dict>
</plist>
