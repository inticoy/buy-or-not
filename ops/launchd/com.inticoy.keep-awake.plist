<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.inticoy.keep-awake</string>
  <!-- 봇들이 도는 동안 맥이 유휴 잠자기에 들지 않게 한다 (관리자 권한 불필요).
       덮개를 닫았을 때의 잠자기는 막지 못한다: sudo pmset -a disablesleep 1 필요 -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-i</string>
    <string>-s</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
</dict>
</plist>
